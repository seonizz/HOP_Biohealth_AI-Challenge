{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./backend/node_modules/@types"],
    "erasableSyntaxOnly": true
  },
  "include": ["api/**/*.ts", "backend/src/**/*.ts", "backend/scripts/**/*.ts"]
}
