# node scripts/init-env.mjs --origin https://api.example.com 으로 비밀값을 생성하세요.
# 외부 PostgreSQL을 쓰면 DATABASE_URL/HOP_MIGRATION_DATABASE_URL을 해당 연결로 수정합니다.
HOP_STATE_DIR=/absolute/path/to/hop-runtime
HOP_DB_ADMIN_PASSWORD=replace-with-random-hex
HOP_DB_MIGRATOR_PASSWORD=replace-with-random-hex
HOP_DB_APP_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql://hop_app:replace-with-random-hex@127.0.0.1:5433/hop
HOP_MIGRATION_DATABASE_URL=postgresql://hop_migrator:replace-with-random-hex@127.0.0.1:5433/hop
HOP_DATABASE_SCHEMA=public
HOP_RUNTIME_ROLE=hop_app
HOP_MIGRATE_ON_START=false
HOP_HOST=127.0.0.1
HOP_PORT=9000
HOP_PUBLIC_ORIGIN=https://api.example.com
HOP_COOKIE_SECURE=true
HOP_COOKIE_SAME_SITE=strict
HOP_CORS_ORIGINS=
HOP_TRUST_PROXY=true
HOP_ALLOW_REGISTRATION=false
HOP_INVITE_CODE=replace-with-random-value
HOP_MODEL_MODE=local
HOP_LLM_BACKEND=openai
HOP_LLM_BASE_URL=http://127.0.0.1:8001/v1
HOP_LLM_MODEL=qwen3.8-27b
HOP_LLM_API_KEY=
HOP_LLM_TIMEOUT_MS=180000
HOP_TITLE_BASE_URL=
HOP_TITLE_MODEL=
HOP_KNOWLEDGE=/absolute/path/to/hop-runtime/knowledge/knowledge.jsonl
HOP_REQUIRE_KNOWLEDGE=true
HOP_DOMAIN=api.example.com
# 말씨 v2 is disabled until an independent encryption key and a restricted DB role are configured.
# Generate a 32-byte base64 key outside source control. Never reuse the DB password.
HOP_V2_ENABLED=false
HOP_V2_ALLOW_DRAFT=false
HOP_V2_MODEL_ENABLED=false
HOP_CONTENT_KEY=
HOP_RESTORE_PENDING=false
HOP_MODEL_CONTEXT_SIZE=16384
