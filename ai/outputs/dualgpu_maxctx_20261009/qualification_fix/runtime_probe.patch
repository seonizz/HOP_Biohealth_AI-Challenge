+def ce_chunk_ranges(flat_rows, requested_chunks):
+    """Match torch.chunk's ceil-sized slices, including fewer effective chunks."""
+    require(type(flat_rows) is int and flat_rows > 0
+            and type(requested_chunks) is int and requested_chunks > 0, 'Invalid CE chunk dimensions')
+    size = (flat_rows + requested_chunks - 1) // requested_chunks
+    return [(start, min(start + size, flat_rows)) for start in range(0, flat_rows, size)]
+
+
+def chunk_reference_ce(hidden, weight, bias, labels, *, chunks, cap):
+    """Independent eager reference with the installed fused CE's GEMM shapes.
+
+    Shift each row once before flattening; retain every hidden row in each
+    BF16 GEMM, including ignored labels. Selecting supervised rows BEFORE
+    linear would change its shape again. No fused loss function is reused.
+    """
+    import torch
+    require(hidden.ndim == 3 and tuple(labels.shape) == tuple(hidden.shape[:2])
+            and bool((labels[:, 0] == -100).all()), 'Invalid chunk-reference label boundary')
+    shifted = torch.full_like(labels, -100, device=weight.device)
+    shifted[..., :-1] = labels[..., 1:].to(weight.device)
+    flat_labels = shifted.reshape(-1)
+    flat_hidden = hidden.reshape(-1, hidden.shape[-1])
+    ranges = ce_chunk_ranges(flat_hidden.shape[0], chunks)
+    values, counts = [], []
+    # Each loss is deliberately eager; the fused path remains torch-compiled.
+    with torch.no_grad():
+        for start, stop in ranges:
+            local_labels = flat_labels[start:stop]
+            selector = local_labels != -100
+            raw = torch.nn.functional.linear(flat_hidden[start:stop].to(device=weight.device, dtype=weight.dtype),
+                                             weight, bias)
+            logits = raw[selector].float()
+            token_ce = torch.nn.functional.cross_entropy(torch.tanh(logits / cap) * cap,
+                                                         local_labels[selector], reduction='none')
+            counts.append(int(selector.sum()))
+            values.extend(token_ce.cpu().tolist())
+            del raw, logits, token_ce
+    require(values and len(values) == int((labels != -100).sum()), 'Chunk reference lost supervised tokens')
+    return values, {'requested_chunks': chunks, 'effective_chunks': len(ranges),
+                    'flat_rows': flat_hidden.shape[0], 'hidden_size': flat_hidden.shape[1],
+                    'chunk_rows': [stop - start for start, stop in ranges],
+                    'supervised_items_per_chunk': counts, 'padding_rows_added': 0}
+
+
+def masked_reference_mean(values, selector):
+    """Global supervised-token denominator, never a mean of per-chunk means."""
+    require(len(values) == len(selector) and all(type(item) is bool for item in selector)
+            and any(selector), 'Invalid reference token selector')
+    return sum(value for value, selected in zip(values, selector) if selected) / sum(selector)
 
 
