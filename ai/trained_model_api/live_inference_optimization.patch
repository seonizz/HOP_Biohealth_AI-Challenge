+    def read_pipe_line(self, descriptor, pending):
+        """Read a bounded frame without holding BufferedReader's shutdown lock."""
+        while not self.stopping.is_set():
+            newline = pending.find(b"\n")
+            if newline >= 0 or len(pending) > MAX_LINE_BYTES:
+                end = newline + 1 if newline >= 0 else len(pending)
+                line = bytes(pending[:end])
+                del pending[:end]
+                return line
+            readable, _, _ = select.select([descriptor], [], [], 0.1)
+            if not readable:
+                continue
+            chunk = os.read(descriptor, min(65536, MAX_LINE_BYTES + 1 - len(pending)))
+            if not chunk:
+                line = bytes(pending)
+                pending.clear()
+                return line
+            pending.extend(chunk)
+        return b""
+
