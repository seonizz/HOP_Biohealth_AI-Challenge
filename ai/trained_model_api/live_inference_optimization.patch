+class ProcessLifecycleTests(unittest.TestCase):
+    def check_open_stdin_exit(self, mode):
+        code = r'''
+import json, os, resource, signal, sys, threading, types
+resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+sys.path.insert(0, sys.argv[1])
+import live_worker as worker
+controller = worker.Controller(lambda *args, **kwargs: None)
+controller.ready = True
+signal.signal(signal.SIGTERM, lambda signum, frame: controller.stop("signal"))
+reader = threading.Thread(target=controller.read, args=(sys.stdin.buffer,), daemon=True)
+reader.start()
+print("ready", flush=True)
+worker.serve(controller, types.SimpleNamespace(), None,
+             idle_timeout=0.1 if sys.argv[2] == "idle" else 30)
+reader.join(timeout=1)
+print(json.dumps({"reason": controller.stop_reason, "reader_stopped": not reader.is_alive()}), flush=True)
+controller.closed.set()
+if reader.is_alive():
+    # A regression must fail without causing a macOS/Python crash dialog.
+    os._exit(3)
+'''
+        process = subprocess.Popen(
+            [sys.executable, "-I", "-B", "-c", code, str(Path(__file__).resolve().parent), mode],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        try:
+            readable, _, _ = select.select([process.stdout], [], [], 5)
+            self.assertTrue(readable, "Lifecycle subprocess did not become ready")
+            self.assertEqual(process.stdout.readline().strip(), "ready")
+            if mode == "signal":
+                process.stdin.write('{"unfinished":')
+                process.stdin.flush()
+                process.send_signal(signal.SIGTERM)
+            # Keep stdin open: communicate() would close it and only test EOF.
+            exit_code = process.wait(timeout=5)
+            output, errors = process.stdout.read(), process.stderr.read()
+            self.assertEqual(exit_code, 0, (output, errors))
+            self.assertEqual(errors, "")
+            self.assertEqual(json.loads(output), {
+                "reason": "idle_timeout" if mode == "idle" else "signal", "reader_stopped": True})
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.wait(timeout=5)
+            process.stdin.close()
+            process.stdout.close()
+            process.stderr.close()
+
+    def test_idle_timeout_exits_cleanly_with_stdin_still_open(self):
+        self.check_open_stdin_exit("idle")
+
+    def test_sigterm_interrupts_an_unfinished_stdin_frame(self):
+        self.check_open_stdin_exit("signal")
+
+
 if __name__ == "__main__":
     unittest.main()
