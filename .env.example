# Generate actual secrets with: npm run setup -- --origin http://localhost:8080
COMPOSE_PROJECT_NAME=malssi
COMPOSE_PROFILES=
HOP_PUBLIC_ORIGIN=http://localhost:8080
HOP_SITE_ADDRESS=:80
HOP_HTTP_BIND=127.0.0.1
HOP_HTTP_PORT=8080
HOP_HTTPS_PORT=8443
HOP_COOKIE_SECURE=false
HOP_DB_ADMIN_PASSWORD=GENERATE_RANDOM_HEX
HOP_DB_MIGRATOR_PASSWORD=GENERATE_DIFFERENT_RANDOM_HEX
HOP_DB_APP_PASSWORD=GENERATE_DIFFERENT_RANDOM_HEX
HOP_CONTENT_KEY=GENERATE_32_BYTES_BASE64
HOP_INVITE_CODE=GENERATE_RANDOM_INVITE
HOP_ALLOW_REGISTRATION=true
HOP_DEMO_ENABLED=true
HOP_V2_ALLOW_DRAFT=true
HOP_V2_MODEL_ENABLED=false
HOP_ORIGINAL_FRONTEND_MODEL_MODE=prototype
HOP_LLM_BASE_URL=http://host.docker.internal:18011/v1
HOP_LLM_MODEL=configure-your-local-model
HOP_LLM_API_KEY=
HOP_MODEL_ALLOWED_ORIGINS=
HOP_MODEL_CONTEXT_SIZE=16384
