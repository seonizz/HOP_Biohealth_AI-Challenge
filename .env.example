# npm run setup이 임의 비밀값을 포함한 .env를 생성합니다.
HOST=127.0.0.1
PORT=9000
PUBLIC_ORIGIN=http://127.0.0.1:9000
POSTGRES_PORT=5433
POSTGRES_PASSWORD=replace-with-random-value
DATABASE_URL=postgresql://malssi:replace-with-random-value@127.0.0.1:5433/malssi
CONTENT_KEY=replace-with-32-byte-base64
SESSION_TTL_DAYS=30
MODEL_BASE_URL=http://127.0.0.1:18080/v1
MODEL_DOCKER_BASE_URL=http://host.docker.internal:18080/v1
MODEL_API_KEY=
MODEL_NAME=malssi-gemma4-31b-step100
MODEL_PROTOCOL=json_prompt
MODEL_TIMEOUT_MS=1800000
