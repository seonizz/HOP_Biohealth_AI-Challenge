{
  "name": "hop-supporter-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "build:cases": "node scripts/build-cases.ts",
    "check:live": "node --env-file-if-exists=.env scripts/live-check.ts --run",
    "check": "tsc --noEmit",
    "test:ci": "node scripts/test-ci.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:grant": "node --env-file-if-exists=.env scripts/grant-runtime.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "worker:v2": "node --env-file-if-exists=.env scripts/malssi-worker.ts",
    "retention:v2": "node --env-file-if-exists=.env scripts/malssi-retention.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "description": "HOP supporter coaching API"
}
