# node scripts/init-env.mjs --origin https://api.example.com 으로 비밀값을 생성하세요.
# 외부 PostgreSQL을 쓰면 DATABASE_URL/HOP_MIGRATION_DATABASE_URL을 해당 연결로 수정합니다.
HOP_STATE_DIR=/absolute/path/to/hop-runtime
HOP_DB_ADMIN_PASSWORD=replace-with-random-hex
HOP_DB_MIGRATOR_PASSWORD=replace-with-random-hex
HOP_DB_APP_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql://hop_app:replace-with-random-hex@127.0.0.1:5433/hop
HOP_MIGRATION_DATABASE_URL=postgresql://hop_migrator:replace-with-random-hex@127.0.0.1:5433/hop
HOP_DATABASE_SCHEMA=public
HOP_RUNTIME_ROLE=hop_app
HOP_MIGRATE_ON_START=false
HOP_HOST=127.0.0.1
HOP_PORT=9000
HOP_PUBLIC_ORIGIN=https://api.example.com
HOP_COOKIE_SECURE=true
HOP_COOKIE_SAME_SITE=strict
HOP_CORS_ORIGINS=
HOP_TRUST_PROXY=true
HOP_ALLOW_REGISTRATION=false
HOP_INVITE_CODE=replace-with-random-value
HOP_MODEL_MODE=local
HOP_LLM_BACKEND=openai
HOP_LLM_BASE_URL=http://127.0.0.1:8001/v1
HOP_LLM_MODEL=qwen3.8-27b
HOP_LLM_API_KEY=
HOP_LLM_TIMEOUT_MS=180000
HOP_TITLE_BASE_URL=
HOP_TITLE_MODEL=
HOP_KNOWLEDGE=/absolute/path/to/hop-runtime/knowledge/knowledge.jsonl
HOP_REQUIRE_KNOWLEDGE=true
HOP_DOMAIN=api.example.com
# 말씨 v2 is disabled until an independent encryption key and a restricted DB role are configured.
# Generate a 32-byte base64 key outside source control. Never reuse the DB password.
HOP_V2_ENABLED=false
HOP_V2_ALLOW_DRAFT=false
HOP_V2_MODEL_ENABLED=false
HOP_CONTENT_KEY=
HOP_RESTORE_PENDING=false
HOP_MODEL_CONTEXT_SIZE=16384
# Dual B→A pipeline. Keep inference disabled until the configured model is validated.
# B and A use the same HOP_DUAL_MODEL_ID/checkpoint; endpoints may be identical.
# Remote upstreams require HTTPS and an exact HOP_MODEL_ALLOWED_ORIGINS allowlist.
# No GPU or worker starts with the API.
HOP_DUAL_ENABLED=false
# Worker transport: api calls the authenticated model I/O service; direct calls the configured inference server.
HOP_DUAL_TRANSPORT=direct
HOP_MODEL_API_URL=http://127.0.0.1:9010
# Required only for a remote HTTPS model API. Exact operator-owned origin, no path.
HOP_MODEL_API_ALLOWED_ORIGIN=
# Independent server-to-server token (>=32 random non-whitespace characters). Never put in frontend.
HOP_MODEL_API_TOKEN=
# Model API process only. Starting the HTTP process does not start inference or GPU.
HOP_MODEL_API_PORT=9010
HOP_MODEL_API_INFERENCE_ENABLED=false
HOP_MODEL_API_TIMEOUT_MS=30000
HOP_DUAL_MODEL_ID=
HOP_DUAL_MODEL_SHA256=
HOP_DUAL_MODEL_URL=
HOP_DUAL_EVALUATOR_URL=
HOP_DUAL_RESPONDER_URL=
HOP_DUAL_API_KEY=
# User-provided Ollama/OpenAI-compatible configuration; server-only, never in frontend.
# HOP_DUAL_* overrides these aliases when both are supplied.
OPENAI_BASE_URL=https://YOUR_GEMMA_HOST/v1
OPENAI_API_KEY=
OLLAMA_MODEL=gemma4:12b
GEMMA_API_URL=https://YOUR_GEMMA_HOST
HOP_MODEL_ALLOWED_ORIGINS=https://YOUR_GEMMA_HOST
HOP_DUAL_PROTOCOL=ollama
HOP_DUAL_PROMPT_PROFILE=test
HOP_DUAL_PROMPT_VERSION=v1
HOP_DUAL_EVALUATION_TIMEOUT_MS=10000
# Draft operational alert thresholds, not clinically validated cutoffs.
HOP_DUAL_THRESHOLD_VERSION=draft-v1
HOP_DUAL_EMOTION_ABSOLUTE=3
HOP_DUAL_EMOTION_DELTA=2
HOP_DUAL_RISK_ABSOLUTE=2
HOP_DUAL_RISK_DELTA=1
