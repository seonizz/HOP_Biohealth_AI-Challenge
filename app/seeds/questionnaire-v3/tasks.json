      "unknown_is_not_value": true
    },
    "chosen_action": {
      "label": "이용자가 선택한 행동",
      "requires_current_source_evidence": true,
      "unknown_is_not_value": true
    }
  },
  "routing": {
    "purpose_known": "do_not_issue_Q3-01",
    "purpose_unknown": "Q3-01_once",
    "generic_message_request": "route_by_requested_action; T1_boundary/T2_time_proposal/T6_support_opening",
    "multiple_explicit_tasks": "track_each_requested_obligation; primary_task_follows_user_priority; never_drop_secondary_obligation_silently",
    "new_goal": "increment_goal_revision_and_replan_unissued_questions; preserve_old_goal_outcome_and_refusal_scopes",
    "clarification_precedence": "common_for_all_tasks; one_budget_for_entire_intake_not_per_task"
  },
  "required_facts_policy": {
    "meaning": "minimum_information_for_full_requested_result_not_mandatory_question_ids",
    "earlier_input_counts": true,
    "already_covered_auto_skip": true,
    "optional_facts_are_not_automatic_questions": true,
    "conditional_requirement": "add_only_when_user_requested_detail_or_output_choice_depends_on_it",
    "no_remaining_questions": "provide_specific_supported_result_and_mark_limited_if_requested_scope_not_met; no_generic_disclaimer_only_when_useful_output_exists"
  },
  "completion_statuses": [
    {
      "value": "completed",
      "label": "현재 과업 완료"
    },
    {
      "value": "limited",
      "label": "제한 결과 제공"
    },
    {
      "value": "awaiting_confirmation",
      "label": "확인 대기"
    },
    {
      "value": "changed_goal_completed",
      "label": "사용자가 바꾼 과업 완료"
    },
    {
      "value": "user_stopped",
      "label": "사용자 요청으로 중단"
    },
    {
      "value": "incomplete",
      "label": "과업 미완료"
    }
  ],
  "completion_rules": {
    "actual_artifact_required_for": [
      "completed",
      "limited",
      "changed_goal_completed"
    ],
    "awaiting_confirmation_requires_active_pending_question": true,
    "user_stopped_is_not_completed": true,
    "system_error": "incomplete with reason=system_error",
    "unsupported_claim": "incomplete even_if_format_valid",
    "new_goal_completed": "changed_goal_completed; old_goal_not_retroactively_completed",
    "no_silent_scope_reduction": true
  },
  "input_compatibility": {
    "no_claim_of_native_app_schema": true,
    "source_question_ids_are_historical_design_ids": true,
    "mixed_subjects_require_source_preserving_event_binding": true,
    "old_required_name_or_min_answers_must_not_be_silently_applied": true
  },
  "output_policy": {
    "relation_analysis": "reported_observation_and_tentative_interpretation_separate; unsupported_fields_unknown_or_omitted_if_schema_allows",
    "existing_safety_handoff": "reuse_existing_approved_policy_and_contact_text; no_new_clinical_policy_here",
    "brief_text": "only_requested_artifact; no_forced_five_cards_or_three_part_speech_detail",
    "full_guide": "use_supported_cards; conversation_detail_optional; when_present_exactly_three_nonempty_contiguous_parts_concatenate_to_script",
    "structured_summary": "requested_items_or_experiences_with_supported_values_and_explicit_unknowns; no_forced_five_cards_or_speech_detail",
    "explicit_user_format_override": "an_explicit_brief_or_one_sentence_request_overrides_task_default_to_brief_text_without_weakening_fact_or_completion_requirements"
  }
}
