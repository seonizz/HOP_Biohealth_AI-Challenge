# npm run setup이 임의 비밀값을 포함한 .env를 생성합니다.
HOST=127.0.0.1
PORT=9000
PUBLIC_ORIGIN=http://127.0.0.1:9000
POSTGRES_PORT=5433
POSTGRES_PASSWORD=replace-with-random-value
DATABASE_URL=postgresql://malssi:replace-with-random-value@127.0.0.1:5433/malssi
CONTENT_KEY=replace-with-32-byte-base64
SESSION_TTL_DAYS=30
# Development default, 1..90 days since the last valid session API access.
# The app purges expired owners at startup and hourly; confirm deployment policy first.
DATA_RETENTION_DAYS=30
MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Docker translates loopback to host.docker.internal; override only if needed.
# MODEL_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=local-ollama
MODEL_NAME=gemma4:12b
MODEL_PROTOCOL=relationship_agent
# combined_blocks: generate the existing draft blocks directly, then review together.
# combined tries one full draft first; staged retains the previous comparison path.
MODEL_STATE_MODE=combined_blocks
# Wire format only; every mode retains the same agent stages and validation.
MODEL_AGENT_FORMAT=json_schema
MODEL_SCHEMA_STRING_LIMITS=false
# Streaming supports localhost, the Docker host alias and numeric private endpoints.
# Detect repeated JSON whitespace and retry the format at the configured address.
# This does not impose an answer time, token, or overall character limit.
MODEL_STREAM_JSON=true
# Local streaming only: finish transport at one complete JSON object, then run
# the original schema/evidence validation and independent review before accepting it.
# Unset/false keeps the provider-finish contract; separate APIs opt in separately.
MODEL_STREAM_COMPLETE_JSON=true
# Use omit for servers that do not accept reasoning_effort.
MODEL_REASONING_EFFORT=none
# 0 disables the answer deadline; transient/validation failures retry internally.
MODEL_TIMEOUT_MS=0
# Set false for compatible APIs without a usable /healthz metadata endpoint.
MODEL_DISCOVER_TOKEN_LIMITS=true
# Optional reviewer on a separately authorized model server; unset keeps one model.
# Name defaults to MODEL_NAME; an omitted review key uses local-ollama.
# MODEL_REVIEW_BASE_URL=http://reviewer.example:11434/v1
# MODEL_REVIEW_DOCKER_BASE_URL=http://reviewer.example:11434/v1
# MODEL_REVIEW_NAME=gemma4:12b
# MODEL_REVIEW_AGENT_FORMAT=json_schema
# MODEL_REVIEW_REASONING_EFFORT=none
# MODEL_REVIEW_API_KEY=local-ollama
# JSON Schema is the default; prompt and json_object are also supported.
# MODEL_REVIEW_STREAM_JSON=false
# MODEL_REVIEW_STREAM_COMPLETE_JSON=false
# MODEL_REVIEW_SCHEMA_STRING_LIMITS=false
# MODEL_REVIEW_DISCOVER_TOKEN_LIMITS=true
# Bulssi classifies saved answers with the configured model by default.
# Set false to disable automatic counseling guidance.
REFERRAL_GUIDANCE_ENABLED=true
# Optional separate Bulssi endpoint; absent uses the main gateway.
# REFERRAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# REFERRAL_MODEL_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
# REFERRAL_MODEL_NAME=gemma4:12b
# REFERRAL_MODEL_API_KEY=local-ollama
# Empty format/reasoning settings inherit the main gateway configuration.
# REFERRAL_MODEL_AGENT_FORMAT=
# REFERRAL_MODEL_REASONING_EFFORT=
# REFERRAL_MODEL_STREAM_JSON=false
# REFERRAL_MODEL_STREAM_COMPLETE_JSON=false
# REFERRAL_MODEL_DISCOVER_TOKEN_LIMITS=true
