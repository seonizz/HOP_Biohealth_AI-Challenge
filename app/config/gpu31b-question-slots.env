# Candidate only: request recovery, unique question slots, detailed final card analysis.
# Requires fresh qualification; do not reuse historical promotion receipts.
# Isolated experiment only. One model POST per answer; final reviews retained.
# Optional 31B call-count profile. Endpoint, credentials, storage, context/output
# limits and constrained JSON decoding belong to the separately verified runner.
MODEL_PROTOCOL=relationship_agent
MODEL_STATE_MODE=combined
MODEL_BUNDLE_COMBINED_TURN_REVIEWS=false
MODEL_BUNDLE_TURN_REVIEWS=false
MODEL_BUNDLE_FINAL_REVIEWS=true
MODEL_BUNDLE_ANALYSIS_PLAN=true
MODEL_STAGE_SCOPED_QUESTION_RULES=true
MODEL_BLOCK_SCOPED_INPUTS=true
MODEL_COMPACT_REVIEW_INPUTS=true
MODEL_COMPACT_REVIEW_OUTPUT=false
MODEL_COMPACT_TURN_REVIEW_OUTPUT=false
MODEL_SAFETY_REVIEW_SELECTION_MAP=true
MODEL_REVIEW_SAFETY_REVIEW_SELECTION_MAP=true
MODEL_COMBINED_TURN_EVIDENCE_IDS=true
MODEL_REVIEW_COMPACT_REVIEW_OUTPUT=false
MODEL_SHARE_REVIEW_SOURCES=true
MODEL_REPAIR_REVIEW_BUNDLE_TASKS=true
MODEL_EXTENDED_FINAL_EVIDENCE_IDS=true
MODEL_REUSE_FINAL_DRAFT=true
MODEL_PRIORITIZE_SPEECH_PREVIEW=true
MODEL_REUSE_REVIEWED_NAME=false
MODEL_REUSE_REVIEWED_SAFETY=false
MODEL_SCOPED_QUALITY_REFINEMENT=true
MODEL_SKIP_FINAL_EXTRAS=false
MODEL_SINGLE_CALL_TURNS=true

MODEL_SINGLE_CALL_QUESTION_ONLY=true
MODEL_DETAILED_CARD_ANALYSIS=true
