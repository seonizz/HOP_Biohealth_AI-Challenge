{
  "name": "malssi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "setup": "node scripts/setup.js",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.js",
    "export:verification": "node --env-file=.env scripts/export-verification.js",
    "questions": "node --env-file=.env scripts/questions.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
